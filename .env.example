# Copy to .env and fill in. `.env` is gitignored.

# --- Supabase (campaignintelligence) ----------------------------------------
# Writes public.basco_* / public.peterson_* via the service role key.
SUPABASE_URL=https://azpapwtnrbzywlnxxecz.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_ANON_KEY=
# Extra projects for enrich_waterfall(source=...). Read-only service role.
# SUPABASE_URL_kemvxzhcxvynmoutwdrh=https://kemvxzhcxvynmoutwdrh.supabase.co
# SUPABASE_SERVICE_ROLE_KEY_kemvxzhcxvynmoutwdrh=
# Or JSON map: SUPABASE_PROJECT_KEYS={"kemvxzhcxvynmoutwdrh":{"service_role_key":"..."}}

# --- Paid waterfall vendors -------------------------------------------------
# Order is fixed: getleads → Smartlead → AI Ark → LeadMagic → Prospeo → FullEnrich.
# Default max_tier is leadmagic (alias lm). Raise to prospeo/fullenrich (fe) to
# spend later paid email tiers.
# getleads is first. Prefer GETLEADS_API_KEY (Bearer on the MCP). OAuth
# refresh tokens also work: python scripts/getleads_auth.py
# GETLEADS_MCP_URL=https://app.getleads.io/api/mcp
# GETLEADS_OAUTH_ISSUER=https://app.getleads.io
# GETLEADS_API_KEY=
# GETLEADS_CLIENT_ID=
# GETLEADS_REFRESH_TOKEN=
# Smartlead is the included plan email finder (name+domain). Falls through when
# monthly credits are spent (GET search-analytics availableCredits).
# AI Ark is next for people, work-email, AND cellphone (LinkedIn / name+domain /
# phone → export/single; mobile-phone-finder for cells).
# Do not use AI Ark for email-to-profile reverse lookup.
# SMARTLEAD_API_KEY=
# SMARTLEAD_FIND_EMAIL_BASE_URL=https://prospect-api.smartlead.ai/api/v1/search-email-leads
# AI_ARK_API_KEY=
# LEADMAGIC_API_KEY=
# PROSPEO_API_KEY=
# FULLENRICH_API_KEY=
# On need=phone, Veriphone confirms the number is a mobile before write.
# VERIPHONE_API_KEY=

# --- Executor concurrency (parallel enrich_waterfall) -------------------------
# GETLEADS_CONCURRENCY=10
# SMARTLEAD_CONCURRENCY=3
# AIARK_CONCURRENCY=8
# LEADMAGIC_CONCURRENCY=6
# PROSPEO_CONCURRENCY=6
# FULLENRICH_CONCURRENCY=4
# VERIPHONE_CONCURRENCY=8
# COMPANY_CONCURRENCY=40

# --- MCP transport ----------------------------------------------------------
# stdio (local Cursor / Claude Desktop) or streamable-http (Railway).
# MCP_TRANSPORT=stdio
# HOST=0.0.0.0
# PORT=8000
