# Copy to .env and fill in. `.env` is gitignored.

# --- Supabase (campaignintelligence) ----------------------------------------
# Writes public.basco_* / public.peterson_* via the service role key.
SUPABASE_URL=https://azpapwtnrbzywlnxxecz.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_ANON_KEY=

# --- Paid waterfall vendors -------------------------------------------------
# Order is fixed: getleads → AI Ark → LeadMagic → Prospeo → FullEnrich.
# Default max_tier is fullenrich (alias fe).
# AI Ark is 2nd for people AND work-email (LinkedIn / name+domain / phone).
# Do not use AI Ark for email-to-profile reverse lookup.
# GETLEADS_API_KEY=
# GETLEADS_BASE_URL=https://app.getleads.io/api
# GETLEADS_FIND_EMAIL_PATH=/find-email
# GETLEADS_PEOPLE_PATH=/people
# AI_ARK_API_KEY=
# LEADMAGIC_API_KEY=
# PROSPEO_API_KEY=
# FULLENRICH_API_KEY=

# --- MCP transport ----------------------------------------------------------
# stdio (local Cursor / Claude Desktop) or streamable-http (Railway).
# MCP_TRANSPORT=stdio
# HOST=0.0.0.0
# PORT=8000
